# ============================================================
# Security hardening — never bundle local secrets into a deployment.
# Production reads these from Vercel project Environment Variables,
# so excluding the local files here does NOT affect production.
# ============================================================
*.env
.env
.env.*
backend/.env
*secret*.txt
*password*.txt
*credential*.txt
