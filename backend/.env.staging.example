# ============================================================
# STAGING environment template for the Uttoron backend.
# Copy this file to  backend/.env.staging  and fill in REAL values THERE.
# backend/.env.staging is git-ignored; THIS .example file is safe to commit
# (placeholders only — never put real credentials in this file).
# ============================================================

# Neon STAGING database (MUST NOT be the production database).
# Keep ?sslmode=require. Shape only — not a real connection string:
DATABASE_URL=postgresql://USER:PASSWORD@STAGING-HOST.neon.tech/DBNAME?sslmode=require

# 32-byte key (64 hex chars) for SEC-6 credential encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the SAME key wherever THIS database's data is encrypted/decrypted.
CREDENTIAL_ENCRYPTION_KEY=

# Seeder (synthetic data) — required by `npm run seed` / `npm run setup`.
SEEDER_PASSWORD=
SEEDER_ADMIN_EMAIL=staging-admin@example.com

# ---- Safety gates for scripts/staging-preflight.mjs ----
# Set to 1 to explicitly confirm the DATABASE_URL above is a STAGING target.
STAGING_OK=
# Comma-separated PRODUCTION DB host(s) the preflight must REFUSE to touch
# (host only, no credentials). Lets the tool deny an accidental prod target.
PRODUCTION_DB_HOSTS=
