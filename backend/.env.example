# App
APP_NAME=Uttoron Coaching Centre
APP_PORT=8000
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uttoron_coaching
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=30d

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@uttoron.com
MAIL_FROM_NAME="Uttoron Coaching Centre"

# SSLCommerz
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_MODE=sandbox

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://uttoroncoachingcentre.vercel.app
