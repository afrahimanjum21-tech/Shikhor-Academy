# App
# NOTE: backend/.env is a LOCAL-development-only file and is never deployed to
# Vercel. Production values (APP_URL, FRONTEND_URL, CORS_ALLOWED_ORIGINS, ...)
# are set in the Vercel project environment variables.
APP_NAME=Uttoron Coaching Centre
APP_PORT=8000
APP_ENV=production
APP_DEBUG=false
# Local dev backend URL. Production overrides this with
# APP_URL=https://uttoron-coaching.vercel.app in Vercel env vars.
APP_URL=http://localhost:8000
# Local dev frontend URL. Production overrides this with
# FRONTEND_URL=https://uttoron-coaching.vercel.app in Vercel env vars.
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL - Neon)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=30d

# Seeders (required before running `npm run seed` / `npm run setup` — no default)
# SEEDER_PASSWORD=
# SEEDER_ADMIN_EMAIL=afrahimamjum00@gmail.com

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@uttoron.com
MAIL_FROM_NAME="Uttoron Coaching Centre"

# SSLCommerz
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_MODE=sandbox

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://uttoron-coaching.vercel.app

# File Storage
# local = backend/uploads on a long-running server
# database = Neon-backed durable /uploads URLs for Vercel/serverless
MEDIA_DRIVER=database
