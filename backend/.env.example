APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# For local development you may use sqlite:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# For production use MySQL (or pgsql for PostgreSQL):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uttoron_coaching
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# Supported drivers: smtp, ses, postmark, resend, mailgun, sendmail, log, array
# For SMTP providers (SendGrid, Brevo, Mailgun SMTP, Gmail SMTP, etc.):
#   Set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION
# For API-based providers (SES, Postmark, Resend):
#   Set MAIL_MAILER to ses/postmark/resend and the corresponding API key in services config
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Uttoron Coaching Center"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173

SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=test_box
SSLCOMMERZ_STORE_PASS=qwerty
SSLCOMMERZ_SUCCESS_URL="${APP_URL}/api/student/payment/success"
SSLCOMMERZ_FAILED_URL="${APP_URL}/api/student/payment/failed"
SSLCOMMERZ_CANCEL_URL="${APP_URL}/api/student/payment/cancel"
SSLCOMMERZ_IPN_URL="${APP_URL}/api/student/payment/ipn"
PAYMENT_FRONTEND_SUCCESS_URL="${FRONTEND_URL}/payment/success"
PAYMENT_FRONTEND_FAILED_URL="${FRONTEND_URL}/payment/failed"
PAYMENT_FRONTEND_CANCEL_URL="${FRONTEND_URL}/payment/cancelled"
