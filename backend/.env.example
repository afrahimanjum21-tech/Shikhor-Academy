# App
# NOTE: backend/.env is a LOCAL-development-only file and is never deployed to
# Vercel. Production values (SITE_URL, APP_URL, FRONTEND_URL, CORS_ALLOWED_ORIGINS, ...)
# are set in the Vercel project environment variables.
APP_NAME=Shikhor Academy
APP_PORT=8000
APP_ENV=production
APP_DEBUG=false
# Local dev backend URL. Production overrides this with
# APP_URL=https://www.shikhoracademy.me in Vercel env vars.
APP_URL=http://localhost:8000
# Local dev frontend URL. Production overrides this with
# FRONTEND_URL=https://www.shikhoracademy.me in Vercel env vars.
FRONTEND_URL=http://localhost:5173
# Canonical public site origin used by /sitemap.xml. In Vercel env vars:
# SITE_URL=https://www.shikhoracademy.me
SITE_URL=http://localhost:5173

# Database (PostgreSQL - Neon)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=30d

# Credential encryption at rest (SEC-6)
# 32-byte key used for AES-256-GCM encryption of sensitive DB columns:
# PaymentSetting.store_password, SiteSetting.smtp_password, SiteSetting.email_api_key.
# Provide as 64 hex chars (or base64 of 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this as a Vercel project Environment Variable in production.
# If unset, those secrets are stored as plaintext (legacy behaviour) and are still
# read transparently — encryption simply stays off until a key is configured.
# KEEP A SECURE BACKUP: losing this key makes already-encrypted secrets unrecoverable
# (they would need to be re-entered in the admin panel).
CREDENTIAL_ENCRYPTION_KEY=

# Seeders (required before running `npm run seed` / `npm run setup` — no default)
# SEEDER_PASSWORD=
# SEEDER_ADMIN_EMAIL=afrahimamjum00@gmail.com

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@uttoron.com
MAIL_FROM_NAME="Shikhor Academy"

# SSLCommerz
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_MODE=sandbox

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.shikhoracademy.me

# File Storage
# local = backend/uploads on a long-running server
# database = Neon-backed durable /uploads URLs for Vercel/serverless
MEDIA_DRIVER=database

# SMS (SSL Wireless - https://sms.sslwireless.com)
# SMS_ENABLED_TYPES = notification types that also fire an SMS to the student
# (exam, payment, notice, material, assignment). Leave SMS_ENABLED=false until
# you have credentials - the service then logs instead of sending.
SMS_ENABLED=false
SMS_API_URL=https://sms.sslwireless.com/pushapi/dynamic/server.php
SMS_API_USER=
SMS_API_PASS=
SMS_API_TOKEN=
SMS_SENDER_ID=UTTORON
SMS_ENABLED_TYPES=exam,payment,notice,material,assignment

# Email (transactional, free tier)
# Brevo (default) - https://www.brevo.com - free 300 emails/day, verify the
# sender email with a click-link (no domain DNS needed):
#   EMAIL_FROM="Shikhor Academy <you@gmail.com>"
# Resend - https://resend.com - free 100 emails/day, requires a verified domain.
# Same EMAIL_ENABLED_TYPES logic as SMS; independent on/off switch.
EMAIL_ENABLED=false
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ENABLED_TYPES=attendance,leave,late,exam,result,payment,notice,material,assignment

# Rate limiting (C24). Default is an in-memory store (per serverless isolate).
# Set to `postgres` to use the shared, DB-backed store (table from migration
# 016) so the limit is GLOBAL across isolates. Run migration 016 before
# enabling. Leave blank/unset to keep the in-memory store.
RATE_LIMIT_STORE=
# CSRF double-submit cookie name (J). Optional; defaults to `uttoron_csrf`.
CSRF_COOKIE_NAME=

# Biometric/fingerprint attendance device ingestion.
# ATTENDANCE_DEVICE_KEY secures POST /api/integrations/attendance/punch. Leave
# BLANK to keep the endpoint DISABLED (503). Set a long random secret (same
# value the local bridge agent sends as the X-Device-Key header) to enable it.
# Multiple comma-separated keys allowed (one per site/device).
ATTENDANCE_DEVICE_KEY=
# Session windows + late grace used to turn a punch time into present/late.
ATTENDANCE_MORNING_START=09:00
ATTENDANCE_EVENING_START=16:00
ATTENDANCE_LATE_GRACE_MIN=15
