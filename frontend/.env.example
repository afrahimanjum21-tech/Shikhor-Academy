# =====================================
# Backend API
# =====================================

# Full URL to the Laravel API (including /api suffix).
# In development with Vite proxy, this can be left empty (defaults to "/api").
# In production, set this to your backend's API URL, e.g.:
#   VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=

# Backend root URL (without "/api" suffix), used for constructing asset URLs
# (images, files, uploads). Falls back to empty string (same origin) if not set.
# In production, set this to your backend's root URL, e.g.:
#   VITE_BACKEND_URL=https://api.yourdomain.com
# Leave empty if the backend is served from the same domain as the frontend.
VITE_BACKEND_URL=
